{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "**/*.cs",
    "**/*.py",
    "**/*.ts",
    "**/*.tsx"
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.git/**",
    "**/.fallow/**",
    "**/.gemini/**",
    "**/bin/**",
    "**/obj/**",
    "**/artifacts/**",
    "**/tmp/**"
  ]
}
