# MS Build / NinjaTrader defaults
bin/
obj/
*.bak*
*.202*
# Zero-Waste Discovery Rule: .agent/rules/zero_waste_discovery.md

# AI System Plumbing (Claude Code / MCP / Antigravity)
# Unignored for portability (identity/manifesto), but brain/logs remain private
.agent/
!.agent/agents/
!.agent/workflows/
!.agent/skills/
!.agent/standards_manifesto.md
!.agent/DIRECTOR.md
.agent/brain/
.agent/logs/

.agents/
!.agents/agents/
!.agents/workflows/
!.agents/skills/
.agents/brain/
.agents/logs/

.claude/
!.claude/settings.json
!.claude/skills/
!.claude/workflows/
.claude/logs/

.mcp/

# JavaScript / TestSprite noise
node_modules/
**/node_modules/
.npm/
package-lock.json
testsprite_tests/

# Temporary / Temp files
~$*
*.tmp
*.log

# Sensitive Info / Env
.env
.env.*
auth.json
*.key

# Agent settings with secrets (use *.template.json as the safe-to-commit version)
.gemini/settings.json
.testsprite/config.json
*.local.json
